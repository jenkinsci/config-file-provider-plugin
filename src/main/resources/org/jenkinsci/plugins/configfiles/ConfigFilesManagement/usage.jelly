<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
	<j:set var="header">
		<l:view>
			<l:app-bar title="${%Usage of Configuration File}">
				<a href="editConfig?id=${config.id}" class="jenkins-button">
					<l:icon src="symbol-create-outline plugin-ionicons-api" />
					${%Edit}
				</a>
			</l:app-bar>
		</l:view>
	</j:set>

	<l:settings-subpage header="${header}" permission="${app.MANAGE}" noDefer="true">
		<j:set var="config" value="${config}"/>
		<j:set var="descriptor" value="${config.descriptor}"/>
		<j:set var="readOnlyMode" value="true"/>
		<f:entry title="${%ID}">
			<f:textbox name="config.id" value="${config.id}" />
		</f:entry>
		<f:entry title="${%Name}">
			<f:textbox name="config.name" value="${config.name}" />
		</f:entry>
		<f:entry title="${%Comment}">
			<f:textbox name="config.comment" value="${config.comment}" />
		</f:entry>
		<j:choose>
			<j:when test="${usageTrackingEnabled}">
				<j:set var="jobs" value="${usage.keySet()}"/>
				<j:choose>
					<j:when test="${empty(jobs)}">
						<p id="usage-missing">
							${%This managed file has not been recorded as used anywhere.}
						</p>
					</j:when>
					<j:otherwise>
						<p id="usage-present">
							${%This managed file has been recorded as used in the following places}:
						</p>
						<table>
							<j:forEach var="j" items="${jobs}">
								<j:set var="job" value="${app.getItemByFullName(j)}"/>
								<j:set var="range" value="${usage[j]}"/>
								<tr>
									<td>
										<j:choose>
											<j:when test="${job!=null}">
												<a href="${rootURL}/${job.url}" class="model-link inside">${j}</a>
											</j:when>
											<j:otherwise>
												${%Unknown}
											</j:otherwise>
										</j:choose>
									</td>
									<td>
										<t:buildRangeLink job="${job}" range="${range}"/>
									</td>
								</tr>
							</j:forEach>
						</table>
					</j:otherwise>
				</j:choose>
			</j:when>
			<j:otherwise>
				<div class="jenkins-alert jenkins-alert-warning">${%Usage tracking is disabled}</div>
			</j:otherwise>
		</j:choose>
	</l:settings-subpage>
</j:jelly>
